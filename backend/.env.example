# Postgres. In dev these come from the repo-root .env.local written by `neon deploy`.
# Pooled (-pooler) URL for the app; direct URL for Alembic migrations.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JSON list of Google OAuth client IDs allowed as ID-token audience (web, iOS, Android)
GOOGLE_CLIENT_IDS=["xxxx.apps.googleusercontent.com"]

# Signs our session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# TypeSafe AI API key for JEV (classifies voice transcripts)
TYPESAFE_API_KEY=

# Anthropic API key for Claude (extracts food items from voice transcripts)
ANTHROPIC_API_KEY=
