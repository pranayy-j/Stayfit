ENVIRONMENT=development
# JSON list of allowed origins
CORS_ORIGINS=["*"]

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://stayfit:stayfit@localhost:5432/stayfit

# JSON list of Google OAuth client IDs allowed as ID-token audience (web, iOS, Android)
GOOGLE_CLIENT_IDS=["xxxx.apps.googleusercontent.com"]

# Signs our session tokens. Generate with: openssl rand -hex 32  (required outside development)
JWT_SECRET=
JWT_EXPIRE_DAYS=30
